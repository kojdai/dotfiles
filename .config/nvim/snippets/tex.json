{
  "Figure": {
    "prefix": "fig",
    "body": [
      "\\begin{figure}[htbp]",
      "  \\centering",
      "  \\includegraphics[width=${1:0.8}\\linewidth]{${2:path}}",
      "  \\caption{${3:caption}}",
      "  \\label{fig:${4:label}}",
      "\\end{figure}",
      "$0"
    ],
    "description": "figure 環境"
  },
  "Itemize": {
    "prefix": "item",
    "body": [
      "\\begin{itemize}",
      "  \\item $0",
      "\\end{itemize}"
    ],
    "description": "itemize 環境"
  }
}
